# Copy this file to .env and fill in your values.
#
# Who sees what: the `retinue` service does not load this file wholesale — its
# docker-compose.yml names every variable its processes read, so a secret meant
# for another service (LITELLM_DB_PASSWORD, OPENROUTER_API_KEY, CALDAV_PASSWORD,
# the messenger accounts' credentials) never enters the agent container, and a
# variable you add here for retinue reaches it only once it is named there or
# in your override's `environment:`. Inside the container, every session the
# framework spawns gets a further allowlist (scripts/session_env.py): capability
# tokens and the model credential (ANTHROPIC_*, ANTHROPIC_CUSTOM_HEADERS
# included) pass; mailbox passwords and the LiteLLM master and picker keys do
# not. A chamber script that reads a variable of its own names it in
# RETINUE_SESSION_ENV_EXTRA (comma-separated; `PREFIX_*` admits a family) — see
# docs/contributing.md, "Session environment".

# Required: GitHub personal access token (needs repo scope for cloning/pushing)
GITHUB_TOKEN=ghp_...

# Chamber repository URLs are deployment-specific: declare them in chambers.json
# (a `url`, or a `url_env` naming an environment variable you set here). The
# shipped chambers.example.json mounts the local example chambers and needs none.
# Example, if a chamber entry uses "url_env": "MY_CHAMBER_REPO":
# MY_CHAMBER_REPO=https://github.com/your-username/your-chamber.git

# Deployment-defined SPARQL stores (extra compose services declared in
# docker-compose.override.yml and advertised there via SPARQL_ENDPOINT_*):
# comma-separated service hostnames to exempt from the egress-audit proxy.
# SPARQL_NO_PROXY=qlever-genomics

# Egress audit: hosts whose TLS connections the proxy forwards unopened, for
# clients that pin their provider's certificate and refuse the audit CA (e.g.
# an end-to-end-encrypted storage CLI). Comma-separated; `*.example.com`
# matches the domain and all subdomains. Each connection is still logged
# (host, port, client) as a TUNNEL entry, without path or content.
# EGRESS_AUDIT_TLS_PASSTHROUGH=*.example-storage.com

# Required for signal-gateway: Signal account (phone number) used by signal-cli
SIGNAL_ACCOUNT=+15551234567

# What the signal-gateway account is for. Fixed by configuration; never inferred
# from message content. One of:
#   inbox   — (default) the account is one of the user's own message sources,
#             like an e-mail inbox. Inbound messages are handed to triage as the
#             user's incoming mail and surfaced on the dashboard (push
#             notification); they are never run as prompts and no reply is sent
#             to the sender.
#   control — the account is a control channel for operating Retinue (the
#             classic gateway). Inbound messages are run as prompts to Ara, who
#             replies on the same channel. Access is restricted to the
#             accepted-requesters allowlist (see README "Accepted requesters");
#             non-allowlisted senders are refused.
# The default is "inbox" so an account cannot drive the system unless you
# explicitly opt in with SIGNAL_GATEWAY_MODE=control.
SIGNAL_GATEWAY_MODE=inbox

# To run several messaging accounts, add one signal-gateway service per account
# in docker-compose.override.yml, each with its own SIGNAL_ACCOUNT,
# SIGNAL_GATEWAY_MODE and its own signal-data volume (never shared between
# accounts). See docker-compose.override.example.yml and the README
# "Messaging accounts" section for a worked example.

# Optional for signal-gateway: restrict language detection to the languages you
# actually speak (comma-separated ISO 639-1 codes). This constrains langdetect
# (text) here, preventing bogus guesses like Latin or Finnish that produce
# unintelligible replies; the shared STT service (voice) folds this setting into
# its own language set together with the other channels'. Leave unset to
# auto-detect any language.
# SIGNAL_SUPPORTED_LANGUAGES=de,en

# Optional for signal-gateway: override language-to-Piper-model map (JSON object)
# PIPER_MODEL_MAP={"en":"en_US-lessac-medium","de":"de_DE-thorsten-high"}

# Optional LiteLLM gateway: uses the Claude Code Max/Pro subscription first,
# then falls back to OpenRouter when Anthropic returns an upstream error.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=http://litellm:4000
# ANTHROPIC_CUSTOM_HEADERS=x-litellm-api-key: Bearer sk-retinue-...
# RETINUE_CLAUDE_MODEL=retinue-claude
# Pin what a bare model alias (opus, sonnet, haiku, fable) means: one setting
# moves the agents and the dashboard's model picker to a new release.
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=
# ANTHROPIC_DEFAULT_FABLE_MODEL=
# RETINUE_GATEWAY_USES_CLAUDE_OAUTH=true

# Claude sign-in monitoring & browser re-login (docs/claude-auth.md). The
# monitor warns in a dashboard conversation before the OAuth sign-in's refresh
# token expires and when the credentials die early; the /claude-auth dashboard
# page renews the sign-in from any browser. Defaults work without any of these.
# CLAUDE_AUTH_MONITOR=0            # disable the monitor entirely
# CLAUDE_AUTH_WARN_DAYS=3          # heads-up this many days before expiry
# CLAUDE_AUTH_STALE_HOURS=24       # unrefreshed-access-token warning threshold
# CLAUDE_AUTH_MONITOR_INTERVAL=300
# Before every `claude` it starts, the framework refreshes an access token that
# expires within this many seconds — once, under a lock all spawners share — so
# concurrent sessions never race each other for the token rotation (0 disables):
# CLAUDE_AUTH_REFRESH_AHEAD_SECONDS=900
# CLAUDE_AUTH_LOCK_WAIT_SECONDS=60   # how long a spawner waits for that lock
# If Anthropic ever moves the OAuth endpoints the flow uses (they are Claude
# Code's own, not a published API), override them without a code change:
# CLAUDE_OAUTH_AUTHORIZE_URL=  CLAUDE_OAUTH_TOKEN_URL=  CLAUDE_OAUTH_REDIRECT_URI=
# CLAUDE_OAUTH_CLIENT_ID=      CLAUDE_OAUTH_SCOPES=     CLAUDE_OAUTH_USER_AGENT=

# Model tiers (docs/model-routing.md). The router tier runs the routing-shaped
# entry points (scheduler prompt jobs, news curation, ask_ara, the presentation
# lint's default) and answers the dashboard door as Ara junior; the frontier
# tier runs supervision and anything junior escalates. Both unset = untiered.
# RETINUE_ROUTER_MODEL=claude-sonnet-5
# RETINUE_FRONTIER_MODEL=claude-opus-5-5
# Give dashboard threads their own default instead of the router tier, while
# dispatch turns — and the messenger channels' inbound turns — stay on it.
# Threads pinned in the model picker are unaffected, and an escalated thread
# still stays with senior; unpinned ones move on their next turn.
# Unset = the dashboard follows RETINUE_ROUTER_MODEL.
# RETINUE_DASHBOARD_MODEL=claude-opus-5-5
# Which model each *subagent* runs on (the Secretary, Herald, Archivist and
# chamber agents pin one in their definition; this overrides it) in the
# claude -p sessions the framework spawns — dashboard threads, messenger
# turns, scheduled jobs, Ask-Ara; the remote-control session keeps the pins.
# JSON object or agent=model pairs; plugin agents are <plugin>:<name>. The
# dashboard's Settings › Agent models card writes a file that wins over this
# default.
# RETINUE_AGENT_MODELS=secretary=ollama/qwen3.6:latest,herald=claude-haiku-5-5
# RETINUE_AGENT_MODELS_FILE=/root/.retinue/agent-models.json

# Per-job model overrides for scheduled tasks. A scheduler prompt job may pin its
# own model via a "model" field in the chamber's .schedule.json, which overrides
# the global RETINUE_CLAUDE_MODEL above. A job that uses ${VAR:-default}
# expansion there exposes that choice as an env var of the chamber's own
# naming, so you can retune it without editing a manifest: set it here and
# name it on the retinue service in your compose override. The framework names
# none. (RETINUE_TRIAGE_MODEL was the retired e-mail triage's; nothing reads
# it any more.)
#
# The one-time triage migration (scripts/migrate-triage.py; docs/contributing.md,
# "The triage migration") needs nothing set. It waits for MAIL_GATEWAY_TOKEN
# (below): without it no mail is handled at all, and nothing is migrated.
#   RETINUE_TRIAGE_MIGRATION=off   hold the boot run (to read --dry-run first)
#   MIGRATE_TRIAGE_MIRROR_WAIT     how long it waits for the mirror's first
#                                  backfill before going ahead (21600 s)
#   MIGRATE_TRIAGE_MODEL_TIMEOUT   how long its one model turn may take (300 s)
#   TRIAGE_STATE_DIR               its marker and snapshot (/root/.retinue/triage)
# LITELLM_MASTER_KEY=sk-retinue-...
# LITELLM_PRIMARY_MODEL=anthropic/claude-opus-5-5   # default when unset
# LITELLM_FALLBACK_MODEL=openrouter/anthropic/claude-sonnet-4
# OPENROUTER_API_KEY=sk-or-v1-...
# LITELLM_DB_PASSWORD=replace-with-a-random-password
# DATABASE_URL=postgresql://litellm:replace-with-a-random-password@litellm-db:5432/litellm
# PROXY_ADMIN_ID=admin
# At-rest encryption key for model credentials stored in the LiteLLM DB
# (store_model_in_db). Set a dedicated random value BEFORE adding any model
# through the admin UI, and NEVER change it afterwards — rotating it makes the
# stored credentials unreadable. Unset, it falls back to LITELLM_MASTER_KEY,
# which then cannot be rotated without losing the stored models.
# LITELLM_SALT_KEY=generate-a-dedicated-random-key-and-never-change-it

# Dashboard conversation-model picker. When the stack routes through LiteLLM,
# the web gateway reads GET /model/info and offers every route whose model_info
# sets `retinue_picker: true` (label: `retinue_label`) — manage the list in
# litellm/config.yaml or the LiteLLM admin UI, nothing to configure here. The
# variables below are only for the exceptional cases:
# RETINUE_LITELLM_URL=            # picker source; defaults to ANTHROPIC_BASE_URL
# RETINUE_LITELLM_KEY=            # auth override; defaults to ANTHROPIC_CUSTOM_HEADERS
# RETINUE_MODELS_CACHE_SECONDS=60 # model-list cache TTL
# RETINUE_CONVERSATION_MODELS=    # inline JSON [{"id","label"},…]; wins over LiteLLM
# RETINUE_CONVERSATION_MODELS_FILE= # static fallback file (JSON-LD, read as JSON)

# Optional shared secret for the STT (speech-to-text) service. When set,
# POST /transcribe requires it; the web gateway and signal-gateway (both
# clients) and the stt service all read it, so set it once. The service is only
# reachable on the internal `agents` network, so this is defence-in-depth.
# STT_TOKEN=
# Optional for the STT service: say outright which languages it decodes for
# (comma-separated ISO 639-1 codes). Unset, it uses the union of the messenger
# channels' *_SUPPORTED_LANGUAGES, since it transcribes for all of them.
# STT_SUPPORTED_LANGUAGES=de,en
# Optional: STT_HOTWORDS=0 turns off biasing the decode with the names in the
# life store; DICTATION_HOTWORD_CHARS caps how much of Whisper's prompt window
# those names may take (default 600 characters). STT_VAD_FILTER=0 decodes the
# raw audio instead of skipping non-speech.
# STT_HOTWORDS=1
# DICTATION_HOTWORD_CHARS=600
# STT_VAD_FILTER=1

# Dashboard voice input: a cleanup pass repairs Whisper's raw transcript (with
# the thread so far and the dictation vocabulary, i.e. names from the life
# store, as context) before it lands in the composer. TRANSCRIPT_CLEANUP_MODEL
# falls back to RETINUE_CLAUDE_MODEL when that is set, else "haiku" — so an
# Ollama/OpenRouter deployment's cleanup pass runs on that same backend instead
# of asking it for an Anthropic-only model name. Set TRANSCRIPT_CLEANUP=0 to disable the pass entirely.
# TRANSCRIPT_CLEANUP=1
# TRANSCRIPT_CLEANUP_MODEL=

# Outbound Signal push (scripts/signal-push.py → signal-gateway /send endpoint).
# Lets Ara initiate messages — alerts, escalations, daily briefings — with a
# spoken audio rendering and optional images, the same pipeline as replies.
#   SIGNAL_DEFAULT_RECIPIENT: who pushes go to when no recipient is given (the
#                             system owner's Signal number, E.164).
#   SIGNAL_GATEWAY_TOKEN:     shared secret; when set, /send requires it. Both
#                             the gateway and retinue read it, so set it once.
# SIGNAL_DEFAULT_RECIPIENT=+15551234567
# SIGNAL_GATEWAY_TOKEN=

# Optional for signal-gateway: outbound send-control policy — the messenger
# analogue of EMAIL_SEND_POLICY. Like e-mail, the category is keyed by the
# SENDING identity (this gateway's own SIGNAL_ACCOUNT number), NOT the recipient:
# what governs an autonomous send is which number it goes out as. A dedicated
# agent number can be granted "allow" while the user's own number stays "verify".
# Categories:
#   allow  — send directly, no confirmation (e.g. a dedicated agent number).
#   trust  — send directly only when signal-push.py passes --user-approved;
#            otherwise the send falls back to the verify flow.
#   verify — register the send as pending; it is transmitted only after explicit
#            web-gateway approval at /sends.
# An account matching no entry and no "*" wildcard falls back to verify
# (fail-safe, same as e-mail). Pending sends appear on /sends alongside e-mail.
# SIGNAL_SEND_POLICY=[{"number":"+15551234567","category":"verify"},{"number":"+15558888888","category":"allow"}]
#
# Public base URL used to build the approval link returned to the caller when a
# send is queued for verification (e.g. https://agents.example.com). When unset,
# a relative /sends path is returned.
# SEND_APPROVAL_BASE_URL=

# Outbound WhatsApp push (scripts/whatsapp-push.py → whatsapp-gateway /send).
# The messenger sibling of the Signal gateway: a dedicated service owns the
# linked-device WhatsApp Web session (its keys live only in that container), so
# agents send through a thin CLI with no MCP tool schema in context.
#   WHATSAPP_ACCOUNT:          this gateway's own number (E.164, the linked
#                              device). Send-control keys off THIS number (below).
#   WHATSAPP_GATEWAY_MODE:     "inbox" (default — the user's own message source,
#                              forwarded to triage, no reply) or "control" (runs
#                              messages as prompts to Ara, restricted to accepted
#                              requesters). Link the device once by scanning the
#                              pairing QR printed to the gateway's logs.
#   WHATSAPP_DEFAULT_RECIPIENT: who pushes go to when no recipient is given.
#   WHATSAPP_GATEWAY_TOKEN:    shared secret; when set, /send requires it. Both
#                              the gateway and retinue read it, so set it once.
# WHATSAPP_ACCOUNT=+15551234567
# WHATSAPP_GATEWAY_MODE=inbox
# WHATSAPP_DEFAULT_RECIPIENT=+15551234567
# WHATSAPP_GATEWAY_TOKEN=

# Optional for whatsapp-gateway: outbound send-control policy — the messenger
# analogue of EMAIL_SEND_POLICY. Like e-mail, the category is keyed by the
# SENDING identity (this gateway's own WHATSAPP_ACCOUNT number), NOT the
# recipient: what governs an autonomous send is which number it goes out as. A
# dedicated agent number can be granted "allow" while the user's own number stays
# "verify". Categories allow / trust / verify (see EMAIL_SEND_POLICY below). An
# account matching no entry and no "*" wildcard falls back to verify (fail-safe,
# same as e-mail), so an undeclared account can never post autonomously. Pending
# sends appear on /sends alongside e-mail and Signal approvals.
# WHATSAPP_SEND_POLICY=[{"number":"+15551234567","category":"verify"},{"number":"+15558888888","category":"allow"}]
#
# Optional: restrict answer-language detection for control-mode replies.
# WHATSAPP_SUPPORTED_LANGUAGES=de,en

# Outbound Telegram (scripts/telegram-push.py → telegram-gateway /send).
# The messenger sibling of the Signal/WhatsApp gateways: a dedicated service logs
# in as your OWN Telegram account (an MTProto user client via Telethon), so it
# acts as you — messages your contacts as you, reads your own DMs (real inbox
# triage), and sees your contact directory. Credentials live only in the gateway.
#   TELEGRAM_API_ID / TELEGRAM_API_HASH: your MTProto app credentials from
#                              https://my.telegram.org → API development tools.
#   TELEGRAM_PHONE:            the account's phone number (E.164), used at login.
#   TELEGRAM_ACCOUNT:          optional explicit sending identity for send-control
#                              (defaults to this account's @username / phone).
#   TELEGRAM_GATEWAY_MODE:     "inbox" (default) or "control" (see Signal above).
#   TELEGRAM_DEFAULT_RECIPIENT: chat_id/@username pushes go to when none is given.
#   TELEGRAM_GATEWAY_TOKEN:    shared secret; when set, /send requires it. Both
#                              the gateway and retinue read it, so set it once.
# Log in once (creates the session in the telegram-data volume; prompts for the
# code Telegram sends you, and your 2FA password if set):
#   docker compose run --rm -it telegram-gateway python3 /app/telegram-gateway.py login
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=+15551234567
# TELEGRAM_ACCOUNT=@me
# TELEGRAM_GATEWAY_MODE=inbox
# TELEGRAM_DEFAULT_RECIPIENT=123456789
# TELEGRAM_GATEWAY_TOKEN=

# Required to delete chats from the dashboard (Archived tab → swipe
# left → Delete): the capability the Signal/WhatsApp/Telegram/SMS and mail
# gateways demand before erasing a chat's messages (the mail gateway first
# moves the thread's mails to the Trash folder). retinue and the gateways read it, so set it
# once, to a long random value (e.g. `openssl rand -hex 32`). Unlike the
# *_GATEWAY_TOKENs it is never handed to agent sessions, so only the user's
# delete can erase a chat. Unset, deleting a chat is refused.
# CHAT_ERASE_TOKEN=

# Optional for telegram-gateway: outbound send-control policy — the messenger
# analogue of EMAIL_SEND_POLICY. Like e-mail, the category is keyed by the
# SENDING identity (this account, TELEGRAM_ACCOUNT), NOT the recipient chat.
# Categories allow / trust / verify. An identity matching no entry and no "*"
# wildcard falls back to verify (fail-safe) — since this is your own account,
# that means every send needs approval unless you grant it explicitly. Pending
# sends appear on /sends alongside e-mail, Signal and WhatsApp approvals.
# TELEGRAM_SEND_POLICY=[{"number":"@me","category":"verify"},{"number":"*","category":"verify"}]
#
# Optional: restrict answer-language detection for control-mode replies.
# TELEGRAM_SUPPORTED_LANGUAGES=de,en

# SMS (opt-in: the `sms` compose profile — sms-db, sms-server, sms-server-worker,
# sms-gateway).
# Your Android phone runs the SMS Gateway for Android app and pairs with the
# self-hosted android-sms-gateway server; full setup in docs/messaging.md, "SMS".
#   COMPOSE_PROFILES=sms       start the four services with the stack.
#   SMS_GATEWAY_BASE_URL:      set to enrol the channel on /sends, /gateways,
#                              the chat surface and the connection monitor.
#   SMS_DB_PASSWORD:           the server's MariaDB password (random, 16+ characters).
#   SMS_SERVER_PRIVATE_TOKEN:  what the app enters as "Private Token" to register
#                              (random, 16+ characters). The profile refuses to
#                              start without both: an empty token would let
#                              anyone register a phone.
#   SMS_SERVER_USERNAME / SMS_SERVER_PASSWORD: the credentials the app shows under
#                              Settings → Cloud Server after it has registered.
#   SMS_WEBHOOK_URL:           the public HTTPS URL routed to sms-gateway's
#                              POST /webhook (see docker-compose.override.example.yml).
#   SMS_WEBHOOK_SIGNING_KEY:   the app's Settings → Webhooks → Signing Key. Unset,
#                              every inbound SMS is refused.
#   SMS_ACCOUNT:               the phone's own number (the sending identity).
#   SMS_SEND_POLICY:           as TELEGRAM_SEND_POLICY, keyed by SMS_ACCOUNT.
#   SMS_GATEWAY_TOKEN:         shared secret for /send and the other internal routes.
#   (No vendor relay: set the app's notification channel to SSE only before it
#   registers — see docs/messaging.md, "Keeping the vendor out".)
# COMPOSE_PROFILES=sms
# SMS_GATEWAY_BASE_URL=http://sms-gateway:8095
# SMS_DB_PASSWORD=
# SMS_SERVER_PRIVATE_TOKEN=
# SMS_SERVER_USERNAME=
# SMS_SERVER_PASSWORD=
# SMS_WEBHOOK_URL=https://sms.example.com/webhook
# SMS_WEBHOOK_SIGNING_KEY=
# SMS_ACCOUNT=+15551234567
# SMS_SEND_POLICY=[{"number":"+15551234567","category":"verify"}]
# SMS_DEFAULT_RECIPIENT=
# SMS_GATEWAY_TOKEN=

# CalDAV — read and write a real calendar (scripts/caldav-gateway.py, with
# scripts/caldav-push.py writing and scripts/caldav-read.py reading).
# Provider-agnostic: the backend (Zoho, or any other RFC 4791 CalDAV server) is
# selected purely by this configuration, never by a provider-specific code path.
# Writes reuse the same /sends approval flow as the messenger channels — enrol it
# via MESSENGER_GATEWAYS in your compose override (see
# docker-compose.override.example.yml); no framework code change needed. Reads
# need no approval and carry no policy: they change nothing, and the credentials
# below never leave the gateway container either way.
#   CALDAV_SERVER_URL:   the account's CalDAV endpoint (see your provider's
#                        docs; for Zoho this is the CalDAV URL under Zoho
#                        Calendar's settings — offered only as one example
#                        endpoint, never special-cased in code).
#   CALDAV_USERNAME / CALDAV_PASSWORD: credentials — use an app password,
#                        never the normal account password.
#   CALDAV_CALENDAR_ID:  optional; which calendar to write to (its CalDAV id,
#                        URL, or display name). Unset = the account's default
#                        calendar for a write, and ALL of its calendars for a
#                        read. When set, it also narrows reads to that calendar;
#                        a read can still ask for another one, or "*" for all.
#   CALDAV_ACCOUNT:      the sending-identity label CALDAV_SEND_POLICY keys on
#                        (not a per-request field — like SIGNAL_ACCOUNT, one
#                        gateway instance = one identity). Defaults to "default".
#   CALDAV_GATEWAY_TOKEN: shared secret; when set, requests require it.
# CALDAV_SERVER_URL=https://caldav.example.com/dav/you@example.com/
# CALDAV_USERNAME=you@example.com
# CALDAV_PASSWORD=
# CALDAV_CALENDAR_ID=
# CALDAV_ACCOUNT=default
# CALDAV_GATEWAY_TOKEN=

# Optional for caldav-gateway: outbound send-control policy — the same
# allow/trust/verify model as EMAIL_SEND_POLICY / SIGNAL_SEND_POLICY, keyed by
# the SENDING identity (CALDAV_ACCOUNT above), NOT any per-request field: what
# governs an autonomous write is which configured calendar it targets. An
# account matching no entry and no "*" wildcard falls back to verify
# (fail-safe), so an undeclared account can never write autonomously. Pending
# events appear on /sends alongside e-mail and the messenger approvals.
# CALDAV_SEND_POLICY=[{"account":"default","category":"verify"},{"account":"agent","category":"allow"}]

# Optional for caldav-gateway: the read side's bounds — the window a range read
# covers when the caller names no end, and the cap on how many events one
# RESPONSE may carry. The window is what bounds the work (CalDAV cannot be asked
# for "the first N in this range"), the cap only keeps the payload finite. Either
# value must be positive and finite; anything else is refused at startup, with a
# warning, in favour of the default below. Reads are token-gated but never
# approval-gated.
# CALDAV_READ_DEFAULT_DAYS=30
# CALDAV_READ_MAX_EVENTS=500

# Optional for web-gateway: which zone event times are shown in, on the /sends
# index and on an event's approval page. The containers run on UTC, so without
# this an event stored as 16:00+00:00 and one stored as 16:00+02:00 both read as
# "16:00" and a mis-zoned entry looks correct on the very page meant to confirm
# it. Presentation only — it never changes what is written. Unset, the gateway
# reads TZ if the deployment passes that into the service, and otherwise renders
# in UTC; an unknown name also falls back to UTC rather than failing the page.
# The dashboard's attention model reads its schedule in the same zone — when
# the focus modes change, when the digests go out (docs/attention-model.md) —
# so unset, a Zurich owner's quiet hours and morning digest run two hours late.
# RETINUE_DISPLAY_TZ=Europe/Zurich

# Optional for web-gateway: the attention model (docs/dashboard.md, "The home").
# ATTENTION_TZ gives the schedule a zone of its own; unset, it follows
# RETINUE_DISPLAY_TZ, then TZ. ATTENTION_PUSH_GATE=0 is the rollback: every
# messenger arrival pushes as it did before the model, while the list, the
# digest and the sweep keep working — for a deployment whose agents do not yet
# declare how much their threads matter (undeclared threads are otherwise
# listed, never pushed). It does not apply to mail, which pushed nothing before
# the model: a mail pushes only on the model's word (a VIP, a prior or a
# permit, an instruction's verdict or its failure rule).
# ATTENTION_TZ=Europe/Zurich
# ATTENTION_PUSH_GATE=1

# Updater sidecar (docker-compose.yml `updater` service, scripts/self-update.py).
# HTTP trigger to rebuild/restart the whole stack
# (`git pull && docker compose build && docker compose up -d`) without SSHing
# into the host — reachable from the phone (via Traefik, token + basic auth;
# see docker-compose.override.example.yml) and from inside retinue.
# Unlike EMAIL_BACKEND_TOKEN/CONVERSATION_BACKEND_TOKEN, this cannot be
# auto-generated at container start: the updater and retinue are separate
# containers/services, so the same value must be set here and shared by both
# via env_file. Required — with no token the updater rejects every request.
# UPDATER_TOKEN=

# Optional for the gateway: use a single explicit allowlist file instead of the
# default union of every chamber's accepted-requesters.txt
# ACCEPTED_REQUESTERS_PATH=/workspace/chambers/<chamber>/accepted-requesters.txt

# Optional: Claude permission mode for remote-control and web gateway invocations.
# See https://code.claude.com/docs/en/permission-modes for options
# Defaults to acceptEdits when not set.
# CLAUDE_PERMISSION_MODE=acceptEdits

# Optional: memory (scripts/memory.py). RETINUE_MEMORY=0 disables the store.
# The weekly compaction job (scripts/memory-compact.py) reads the rest; the
# values shown are the defaults (docs/memory.md, "The compaction job").
# RETINUE_MEMORY=1
# RETINUE_MEMORY_FREEZE_DAYS=14
# RETINUE_MEMORY_MIN_CLUSTER=5
# RETINUE_MEMORY_BATCH=40
# RETINUE_MEMORY_MAX_BATCHES=10
# RETINUE_MEMORY_ALERT_AFTER=3
# RETINUE_MEMORY_STATE_DIR=/root/.retinue/memory

# Optional: task scheduler (scripts/scheduler.py) tunables. Jobs are declared in
# chambers/<chamber>/.schedule.json; these only adjust the daemon itself.
# SCHEDULER_TICK_SECONDS=30
# SCHEDULER_JOB_TIMEOUT=900
# SCHEDULER_STATE_DIR=/root/.retinue/scheduler

# --- Data refresh sources (scripts/refresh.py) ---------------------------------
# A refresh source is a chamber's own fetch command (.refresh.json). Its
# credentials are chamber configuration: list them on the `retinue` service in
# the deployment's override and name them in RETINUE_SESSION_ENV_EXTRA, so the
# sessions that run `refresh.py --ensure` can see them. Use an app password or
# a dedicated login for third-party accounts where available.

# Remote access auth. The public `agents` router accepts EITHER a TLS client
# certificate OR basic auth (alternatives — see deploy/traefik/README.md).
#
# Basic-auth users, htpasswd-style (apr1/MD5 from `htpasswd -nb user pass`; double
# the `$` when copying into this file). This value is now ALSO read by the gateway,
# which verifies the password at /auth so a certificate can be offered instead.
# TRAEFIK_BASIC_AUTH_USERS=user:$$apr1$$...$$...
TRAEFIK_BASIC_AUTH_USERS=
#
# Optional: require the client certificate's Common Name to equal this value
# (extra restriction on top of CA verification). Empty = accept any cert signed
# by the client CA. Issue certs with scripts/gen-client-cert.sh.
# GATEWAY_CLIENT_CERT_CN=
#
# Optional: confine a basic-auth user to named hosts, `user:host` (repeat the
# user for several hosts; `user:*` means any). A user NOT named here keeps
# unrestricted access, so this is opt-in per credential. Use it for every
# credential handed to a third party — see the Ask-Ara block below. Out of
# scope the gateway answers 403, not 401, so a browser does not loop on a
# password that is correct but wrong for that router.
# GATEWAY_BASIC_AUTH_SCOPES=ara-mcp:ara.example.com
#
# Recommended: the address the reverse proxy connects from (give Traefik a fixed
# one on the `web` network; never a range that holds this container's own), for
# without it the endpoints that act with the user's own authority — a chat's
# send, flags and delete, a new mail, a thread's delete, a shell action's
# outcome, approving a pending send, and the marking of a dashboard message as
# the user's own — refuse only loopback and the address a caller dialled,
# and take a caller inside the container that comes in from its other network or
# through the egress-audit proxy for the dashboard.
# EDGE_PROXY_PEERS=172.30.0.2

# --- Ask-Ara MCP connector (scripts/ara-mcp-server.py) -----------------------
# Lets an outside Claude client (a local cowork session, the desktop app)
# consult Ara instead of interrupting you. Off by default: it is a new external
# surface. Enable it, route a host to port 8110 in your compose override (see
# docker-compose.override.example.yml), give it its OWN htpasswd user in
# TRAEFIK_BASIC_AUTH_USERS, and scope that user above — the connector's password
# must not also open the dashboard.
# ARA_MCP_ENABLED=1
#
# Optional: which model answers. Empty = the container's default.
# ARA_MCP_MODEL=

# --- E-mail (scripts/email_client.py, IMAP+SMTP) -----------------------------
# Provider-independent e-mail access for the Secretary agent. Always use an
# *app password* (provider security settings), never the normal login password.
# The "default" account uses the unsuffixed variables; named accounts append an
# upper-cased suffix and are selected with `email_client.py --account <name>`.
#
# Default account (example: Zoho):
# EMAIL_USER=you@example.com
# EMAIL_PASS=
# IMAP_HOST=imap.zoho.eu
# IMAP_PORT=993
# SMTP_HOST=smtpout-mail.zoho.eu
# SMTP_PORT=587
# SENT_FOLDER=Sent
# DRAFTS_FOLDER=Drafts
# SMTP_SAVE_SENT=true
#
# Named account "ari" (Gmail). Gmail saves Sent itself, so SMTP_SAVE_SENT=false.
# Special-folder names are localized to the mailbox language — this account is
# German (run `email_client.py --account ari folders` to confirm yours):
# EMAIL_USER_ARI=assistant@example.com
# EMAIL_PASS_ARI=
# IMAP_HOST_ARI=imap.gmail.com
# SMTP_HOST_ARI=smtp.gmail.com
# SENT_FOLDER_ARI=[Gmail]/Gesendet
# DRAFTS_FOLDER_ARI=[Gmail]/Entwürfe
# SMTP_SAVE_SENT_ARI=false
#
# Additional accounts (e.g. persona mailboxes) are configured with the same
# variables above using an upper-cased suffix, then selected at call time via the
# --account flag:
#   email_client.py --account ari list --folder INBOX
# All credentials stay in this file and are covered by the credential isolation
# described below. Prefer this over --env-file for every new account.
# The retinue service receives only the DEFAULT account's variables from this
# file (docker-compose.yml names what it passes): a named account's
# EMAIL_USER_<NAME>, EMAIL_PASS_<NAME>, IMAP_HOST_<NAME>, SMTP_HOST_<NAME> (plus
# whichever optional ones you set) must also be listed under the retinue
# service's `environment:` in your docker-compose.override.yml, or the
# gateway's e-mail backend cannot see them.
#
# NOTE: --env-file / EMAIL_ENV_FILE loads a per-call dotenv file, but any file
# passed that way is readable by the agent and bypasses the credential isolation,
# so using it gives the agent direct SMTP/IMAP access and lets it circumvent the
# send-control policy. Avoid --env-file; add credentials here as a named account
# instead.

# --- E-mail send-control policy (sender-address based) ------------------------
# Every outgoing e-mail is governed by the *control category* of its sender
# address. EMAIL_SEND_POLICY is a JSON array of {address, category[, account]}.
# Categories:
#   verify — never sent directly; email_client.py saves a pending draft and
#            returns an approval_url. The user approves/denies on the web gateway
#            (GET /sends). Only then is the e-mail dispatched.
#   trust  — sent directly only when the model passes `send --user-approved`;
#            without that flag it falls back to the verify flow.
#   allow  — sent directly, no confirmation (use for an autonomous mailbox like
#            an agent persona's own address).
# "account" (optional) is the email_client --account suffix that owns the address
# (omit/null for the default account). Addresses not listed fall back to a "*"
# wildcard entry, or — absent that — to "verify" (the fail-safe default).
# The mail gateway (below) applies the same value to the mail it sends — the
# user's composer, scripts/mail-push.py, an agent's reply — and queues a
# "verify" send in its own pending store on /sends, not as an IMAP draft; a
# "trust" send goes out for the user's own press in the composer.
# EMAIL_SEND_POLICY=[{"address":"you@example.com","category":"verify"},{"address":"assistant@example.com","category":"allow","account":"ari"}]
#
# A "verify" send is parked as an IMAP draft until approved, so it round-trips
# through the provider's store; some providers stamp headers onto it there that
# must not travel on to the recipient (see DEFAULT_STRIP_HEADERS). Read only by
# the web gateway process, since that's the only place approval happens.
# SEND_STRIP_HEADERS=X-ZohoMail-Sender
#
# --- E-mail credential isolation (web-gateway backend) ------------------------
# SMTP/IMAP credentials are kept out of the agent's environment entirely. In
# remote-control mode the entrypoint strips EMAIL_PASS* from the main session's
# env, and every session the framework spawns (dashboard turns, scheduled jobs,
# Ask-Ara answers) is built from the allowlist in scripts/session_env.py, which
# passes no mailbox credential at all; both point email_client.py at the web
# gateway's internal endpoint, and the gateway — the only process in the agent
# container that keeps the credentials — runs the real IMAP/SMTP commands
# (the mail gateway, below, holds them too, in a container of its own). The agent then cannot
# read the passwords nor bypass the send-control policy (e.g. it has no
# `approve` command; approvals happen only on the web gateway). This is gated
# by a shared EMAIL_BACKEND_TOKEN; if you do not set one, the entrypoint
# auto-generates a random token at start-up, since there is no legitimate
# reason for an agent to bypass the policy. Set it explicitly only if another
# process needs to reach the internal endpoint.
# Note: persona secret files loaded via `--env-file` still sit on a disk the
# agent can read (see the --env-file warning above).
# EMAIL_BACKEND_TOKEN=
#
# --- E-mail as chats (the mail-gateway service) -------------------------------
# The mail gateway mirrors the DEFAULT account above (the same EMAIL_USER,
# EMAIL_PASS, IMAP_*, SMTP_*, SENT_FOLDER, … — nothing to set twice) into the
# chat ledger, so its threads show on the Chats page, and writes back: replies
# and new mail leave through it under EMAIL_SEND_POLICY above, and Mark as
# read, Archive and Delete in the chat reach the mailbox (Delete moves the
# thread's mails to the Trash folder and erases the mirror; nothing is
# expunged). It is also the delivery gate for mail: an arriving mail is shown
# in its chat and pushes nothing by default; a contact says otherwise — a VIP's
# mail rings and is worked by a model turn, an instructed sender's is worked by
# their instruction (set both on the Contacts page; a contact can cover a whole
# e-mail domain). News mail is filed to the feed from here. There is no e-mail
# triage any more, and no daily sweep.
# The container always runs, but mirrors NOTHING until you opt in by setting
# MAIL_GATEWAY_TOKEN — so an upgrade that changes nothing here mirrors
# nothing. Until then, and with no mailbox configured, /gateways shows it as
# not set up and says why. Full description: docs/messaging.md, "E-mail (the
# mail gateway)".
#   MAIL_GATEWAY_TOKEN:      the opt-in, and the shared secret of the gateway's
#                            HTTP API (compose passes this one value to both
#                            retinue and the gateway). Random, e.g.
#                            `openssl rand -hex 32`. Unset: no mirror, no API.
#   MESSENGER_BUILTIN_CHANNELS: unset by default (all built-in channels).
#                            A deployment that pins it must list `email`, or
#                            the mail gateway idles as not configured; set it
#                            here, since a value only on the retinue service
#                            does not reach the gateway.
#   MAIL_OWN_ADDRESSES:      every address of yours that may appear on this
#                            mailbox's mail, comma-separated: its aliases AND
#                            the addresses of your other mirrored accounts.
#                            Never a participant; without it, a thread that
#                            reaches two of your accounts lists you as a
#                            correspondent in each.
#   MAIL_BACKFILL_DAYS:      how far back INBOX and Sent are mirrored on first
#                            run (default 90; 0 = only new mail). Mail already
#                            read in a client starts read.
#   MAIL_POLICY_WAIT_SECONDS: the mirror starts only once the e-mail policy
#                            file is in place (the retinue container puts it
#                            there first thing at start); unset or 0 waits as
#                            long as it takes, a positive number gives up after
#                            that many seconds and mirrors as with no flags.
#   MAIL_ARCHIVE_FOLDER:     the archive folder the mirror follows, and where
#                            Archive in the chat moves its INBOX mails. Unset:
#                            the server's own \Archive (else \All) folder, else
#                            "Archive"; set: always this name (created and
#                            subscribed if absent).
#   MAIL_TRASH_FOLDER:       where Delete in the chat moves its mails. Unset:
#                            the server's own \Trash folder, else "Trash"; set:
#                            always this name. Never created: with no such
#                            folder, Delete is refused and nothing is erased.
#   MAIL_SENT_GRACE_SECONDS: how long a mail the gateway sent waits for its Sent
#                            copy before it counts as gone from the mailbox
#                            (default 600; matters with SMTP_SAVE_SENT=false).
#   CHAT_ERASE_TOKEN:        delete needs it (set once, above, for every gateway);
#                            unset, deleting a mail chat is refused. A session
#                            never holds it.
#   SEND_APPROVAL_BASE_URL:  the public base of the approval link a queued mail
#                            returns (set once, above; SEND_APPROVAL_SLUG
#                            overrides the /sends/<slug>/<id> segment, normally
#                            unset).
#   MAIL_NEWS_FOLDER:        where a mail of a sender or list flagged both
#                            `news` and `ignored` is moved once the feed has
#                            it (it is marked read too). Unset: the archive
#                            folder. Set and EMPTY (`MAIL_NEWS_FOLDER=`): marked
#                            read and left in the INBOX. A name: that folder
#                            (created and subscribed if absent).
#   MAIL_NEWS_EXCERPT_CHARS: how much of a news mail's text its feed item
#                            carries beside the subject (default 600).
#                            These two were TRIAGE_NEWS_FOLDER and
#                            TRIAGE_NEWS_EXCERPT_CHARS: an old name in this
#                            file is still read where the new one is not set
#                            (an empty value included) — rename it.
#   MAIL_RAIL_FILE_BYTES:    up to which size one attachment travels with the
#                            mail of a VIP or an instructed sender, so the turn
#                            that works it can open it (default 25 MiB, the web
#                            gateway's CONVERSATION_MAX_ATTACHMENT_BYTES).
#   MAIL_RAIL_JOB_TIMEOUT:   how long such a turn is waited for before its mail
#                            counts as not taken and is offered to the chat
#                            again (default 3600 seconds).
#   MAIL_UNREAD_OFFER_WAIT:  how long the mail of a VIP or an instructed sender
#                            that arrived unreadable waits for its reading
#                            before it rings, and is worked, as the placeholder
#                            it is (default 600 seconds; 0: at once).
#   MAIL_POLL_SECONDS:       poll interval (default 60).
#   MAIL_MAX_PART_BYTES / MAIL_MAX_MAIL_BYTES: size caps for one attachment
#                            (default 25 MiB) and one mail (default 50 MiB; a
#                            larger mail keeps its text and no attachments).
#   The rest (backfill batch and pause, IMAP timeout, …): docs/messaging.md.
#   On the retinue side compose also passes, each with its default, the
#   tunables of the web gateway and mail-push.py for mail chats (none needs
#   setting): MAIL_SEND_TIMEOUT (120: how long the dashboard waits for a send
#   before it calls the mail "not confirmed yet"), MAIL_GATEWAY_TIMEOUT (120:
#   mail-push.py's wait), CHAT_PENDING_TIMEOUT (4), CHAT_PENDING_RETRY_SECONDS
#   (15), CHAT_PENDING_SYNC_SECONDS (20) and MAILBOX_NONE_SECONDS (600): how
#   the chat list follows the gateway's queue of mails waiting for approval,
#   MAILBOX_RETRY_SECONDS (120) / MAILBOX_OWED_KEEP_SECONDS (604800): how
#   often a mailbox call that failed is tried again, and for how long,
#   MAIL_ORIGINAL_MAX_BYTES / MAIL_ORIGINAL_INLINE_MAX_BYTES (4 / 8 MiB): the
#   caps of the Original view. Table: docs/messaging.md.
#   The model trim (docs/dashboard.md, "The model trim"): one tool-less turn
#   per mail the deterministic trim left wanting, on first view, choosing the
#   lines that are the author's own. MAIL_MODEL_TRIM (1; 0 switches it off),
#   MAIL_MODEL_TRIM_MODEL (unset: RETINUE_ROUTER_MODEL, else the gateway's
#   default, else haiku), MAIL_MODEL_TRIM_TIMEOUT (60), MAIL_MODEL_TRIM_DAILY_MAX
#   (200 turns a local day, counting only turns that reached the model),
#   MAIL_MODEL_TRIM_QUEUE (30), MAIL_MODEL_TRIM_RETRY_SECONDS (3600: how long a
#   mail waits after its first turn without a judgement — four times as long
#   after the second, a day after any further one where the attempts allow
#   it) and MAIL_MODEL_TRIM_ATTEMPTS (3: how many such turns a mail gets; the
#   last settles it as the rules trimmed it, so with 3 the waits are an hour
#   and four hours).
#   Three more decide how a VIP's or an instructed sender's mail is worked
#   (docs/dashboard.md, "The gate for mail"): MAIL_INSTRUCTION_TIMEOUT (600:
#   how long an instruction may hold a mail's ring — longer than a
#   messenger message's CHAT_INSTRUCTION_TIMEOUT of 60, since a turn that
#   files a document runs longer than one that drafts a reply),
#   CHAT_ARRIVAL_RETRY_SECONDS (900: how old a failed turn must be before the
#   mail's next offer starts it anew) and MAIL_ARRIVAL_TURN_ATTEMPTS (3: how
#   many turns one mail gets before it is accepted as it stands).
#   The mail-data volume holds mails waiting for approval, not only indexes:
#   recreating it drops them.
# A named account is a second gateway service: docker-compose.override.example.yml.
# MAIL_GATEWAY_TOKEN=
# MAIL_OWN_ADDRESSES=
# MAIL_BACKFILL_DAYS=90
#
# --- Conversation tabs (dashboard chat backend) ------------------------------
# The dashboard's conversation-tabs card backs onto the gateway's /conversations
# API. Agents can also *open* a thread that needs the user's decision via the
# token-gated /internal/conversations endpoint (scripts/conversation-push.py).
# Like EMAIL_BACKEND_TOKEN, the entrypoint auto-generates a random token at
# start-up when none is supplied; set it explicitly only if another process
# needs to reach the internal endpoint.
# CONVERSATION_BACKEND_TOKEN=
#
# Public base URL for building links in dashboard conversations and e-mail send
# approvals (e.g. https://agents.example.com). When unset, a relative path is
# used. Used by web-gateway.py for push-notification and journal URLs.
# CONVERSATION_BASE_URL=https://agents.example.com
#
# Instance branding, only needed when you run more than one deployment and
# install each dashboard as a PWA: a short label (home-screen name, page titles
# "Retinue (<label>)", push titles, the Ask-Ara default identity
# "Ara (<label>)", and the name the Android shell lists the instance under) and
# the accent colour of icons and dashboard (buttons, links, highlights; pick a
# light or medium tone). Unset = stock "Retinue" in blue. These are the
# deployment defaults: Settings › Instance on the dashboard stores its own
# choices in RETINUE_INSTANCE_FILE (default /root/.retinue/instance.json), which
# win while set (scripts/instance_branding.py).
# RETINUE_INSTANCE_NAME=Admin
# RETINUE_INSTANCE_COLOR=#f59e0b
#
# The dashboard's Content-Security-Policy, sent with every page: scripts run
# only from the dashboard's own files, so markup that reached a page from
# outside could not run script there. Three modes:
#   report   (default) the browser blocks nothing and reports what the policy
#            would block; the distinct reports are at GET /csp-report
#   enforce  the browser blocks it (and still reports it)
#   off      no policy header
# Leave it on report for about a week of normal use, read /csp-report, and
# switch to enforce once it lists nothing the dashboard needs
# (docs/dashboard.md, "The Content-Security-Policy").
# RETINUE_CSP=report
# Where the reports are kept (default /root/.retinue/csp-reports.json, beside
# the conversations on the persistent volume).
# RETINUE_CSP_REPORTS_FILE=
#
# Public base URL for e-mail send-approval links; falls back to
# CONVERSATION_BASE_URL when unset. Messenger gateways (Signal, WhatsApp,
# Telegram) do not use this setting.
# SEND_APPROVAL_BASE_URL=
#
# The owner's own actor URI, used by the dashboard's projects card
# (web-gateway.py) to split projects into "your move" (current_actor matches
# this) versus "waiting on <them>" (anything else). Must be in the same
# urn:retinue:actor:<slug> shape scripts/discover-agents.py assigns every AI
# agent, and match the current_actor a chamber's converter emits for the
# owner's own projects. Defaults to urn:retinue:actor:owner, which no real
# project is likely to use, so an unset value fails safe into "everything is
# waiting on someone else" rather than silently claiming the wrong person's
# projects.
# RETINUE_OWNER_ACTOR=urn:retinue:actor:<your-slug>
